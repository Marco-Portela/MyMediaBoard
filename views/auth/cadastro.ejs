<%- include('../partials/header') %>

<div class="auth-box">
    <h2>Criar Conta no M²B</h2>
    <p>Comece a organizar seus filmes, séries e animes favoritos.</p>

    <form action="/cadastro" method="POST">
        <div class="form-group">
            <label for="nome">Nome Completo:</label>
            <input type="text" id="nome" name="nome" placeholder="Digite seu nome" required>
        </div>

        <div class="form-group">
            <label for="email">E-mail:</label>
            <input type="email" id="email" name="email" placeholder="seu-email@exemplo.com" required>
        </div>

        <div class="form-group">
            <label for="senha">Senha:</label>
            <input type="password" id="senha" name="senha" placeholder="Crie uma senha segura" required>
        </div>

        <button type="submit" class="btn-submit">Cadastrar</button>
    </form>

    <p class="auth-footer">Já tem uma conta? <a href="/login">Faça login aqui</a>.</p>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/header') %>

<div class="form-container">
    <h2>Editar Conteúdo</h2>
    <p>Modifique as informações ou mude o status de <strong><%= item.titulo %></strong>.</p>

    <form action="/colecao/editar/<%= item.id %>" method="POST">
        <div class="form-group">
            <label for="titulo">Título:</label>
            <input type="text" id="titulo" name="titulo" value="<%= item.titulo %>" required>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="tipo">Tipo de Conteúdo:</label>
                <select id="tipo" name="tipo" required>
                    <option value="Filme" <%= item.tipo === 'Filme' ? 'selected' : '' %>>Filme</option>
                    <option value="Série" <%= item.tipo === 'Série' ? 'selected' : '' %>>Série</option>
                    <option value="Anime" <%= item.tipo === 'Anime' ? 'selected' : '' %>>Anime</option>
                    <option value="Animação" <%= item.tipo === 'Animação' ? 'selected' : '' %>>Animação</option>
                </select>
            </div>

            <div class="form-group">
                <label for="genero">Gênero:</label>
                <input type="text" id="genero" name="genero" value="<%= item.genero %>">
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="status">Status:</label>
                <select id="status" name="status">
                    <option value="Não iniciado" <%= item.status === 'Não iniciado' ? 'selected' : '' %>>Não iniciado</option>
                    <option value="Em andamento" <%= item.status === 'Em andamento' ? 'selected' : '' %>>Em andamento</option>
                    <option value="Concluído" <%= item.status === 'Concluído' ? 'selected' : '' %>>Concluído</option>
                </select>
            </div>

            <div class="form-group">
                <label for="nota">Sua Nota (0 a 10):</label>
                <input type="number" id="nota" name="nota" min="0" max="10" value="<%= item.nota %>" placeholder="Sem nota">
            </div>
        </div>

        <div class="form-group checkbox-group">
            <label for="favorito">
                <input type="checkbox" id="favorito" name="favorito" value="1" <%= item.favorito === 1 ? 'checked' : '' %>>
                Marcar como Favorito ⭐
            </label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-salvar">Atualizar Alterações</button>
            <a href="/colecao" class="btn-cancelar">Cancelar</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>